wwv_flow_imp_page.create_page_plug(
 p_id=>wwv_flow_imp.id(@OFFSET_30@)
,p_plug_name=>'ECO descriptions'
,p_parent_plug_id=>wwv_flow_imp.id(@OFFSET_0@)
,p_plug_template=>4072358936313175081
,p_plug_display_sequence=>30
,p_function_body_language=>'PLSQL'
,p_plug_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'declare',
'  l_html clob := to_clob(''<div class="chess-eco-list">'');',
'  l_offset pls_integer;',
'begin',
'  for r in (select eco_code,description from orac_chess.chess_eco_code_v',
'    where :P@PAGE@_ECO_SEARCH is null or instr(lower(eco_code),lower(:P@PAGE@_ECO_SEARCH))>0',
'      or dbms_lob.instr(lower(description),lower(:P@PAGE@_ECO_SEARCH))>0',
'      or instr('':''||:P@PAGE@_ECO_EDITOR||'':'','':''||eco_code||'':'')>0 order by eco_code) loop',
'    l_html := l_html || ''<details><summary><span class="t-Badge">'' || apex_escape.html(r.eco_code) || ''</span></summary><div class="chess-eco-description">'';',
'    l_offset := 1;',
'    while l_offset <= dbms_lob.getlength(r.description) loop',
'      l_html := l_html || apex_escape.html(dbms_lob.substr(r.description, 1000, l_offset));',
'      l_offset := l_offset + 1000;',
'    end loop;',
'    l_html := l_html || ''</div></details>'';',
'  end loop;',
'  return l_html || ''</div>'';',
'end;'))
,p_plug_source_type=>'NATIVE_DYNAMIC_CONTENT'
,p_ajax_items_to_submit=>'P@PAGE@_ECO_SEARCH,P@PAGE@_ECO_EDITOR'
,p_attributes=>wwv_flow_t_plugin_attributes(wwv_flow_t_varchar2('expand_shortcuts','N','output_as','HTML','show_line_breaks','Y')).to_clob
);
