[home_assistant]
protocol = http
host = %home_assistant_host%
port = 8123
verify_ssl = false
websocket_path = /api/websocket
sync_on_startup = true
structural_refresh_mode = hourly
structural_refresh_minutes = 60
enable_websocket = true
ws_reconnect_seconds = 10
ws_ping_interval_seconds = 30
ws_ping_timeout_seconds = 10
capability_page_size = 50
capability_max_page_size = 200
max_entities_per_operation = 25
target_service_discovery_limit = 250
visible_entity_patterns = *
readable_entity_patterns = *
controllable_entity_patterns = *
denied_entity_patterns =
confirmation_required_capabilities = close,lock,open,select_option,set_position,set_value,stop,trigger_action,unlock
control_timeout_seconds = 5
light_control_timeout_seconds = 5
light_state_query_timeout_seconds = 5
sensor_query_timeout_seconds = 5
enable_state_poll_fallback = false
state_poll_seconds = 120
sensor_stale_hours = 6
log_level = INFO
